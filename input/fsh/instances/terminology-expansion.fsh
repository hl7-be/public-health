Instance: terminology-expansion
InstanceOf: Parameters
Usage: #definition
Description: "Parameters used to configure terminology expansion."

* parameter[+].name = "includeDesignations"
* parameter[=].valueBoolean = true

* parameter[+].name = "system-version"
* parameter[=].valueCanonical = "http://snomed.info/sct|http://snomed.info/sct/11000172109"